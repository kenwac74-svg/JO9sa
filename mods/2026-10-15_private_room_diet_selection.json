    {
      "location": "slave_private_room1",
      "field": "body",
      "old": "if $snk_room_view = 'diet':\r\n*p '<div class=\"snk_room_overlay\" id=\"snk_room_diet\"><h2>식사 설정</h2>'\r\n*p '<div class=\"snk_close\"><a class=\"snk_button \" tooltip-data=\"식사 설정 닫기\" href=\"EXEC: gt $curloc, ''''\"><img src=\"content/pic/buttons/close_button.png\"></a></div>'\r\nif room1_state > CONST_INT['no_slave']:\r\n*p '<div class=\"snk_diet_row\">'\r\nif room1_ration = 1:\r\n*p '<a class=\"snk_button \" tooltip-data=\"일반식 선택됨\" href=\"EXEC: gt $curloc, ''diet''\"><img src=\"content/pic/buttons/sel_button.png\"></a>일반식 · 2 스파크/일'\r\nelse\r\n*p '<a class=\"snk_button \" tooltip-data=\"일반식\" href=\"EXEC: room1[''special_diet_days''] = 0 & room1_ration = 1 & $room1_info_text = $room1_ration[2] & gt $curloc, ''diet''\"><img src=\"content/pic/buttons/unsel_button.png\"></a>일반식 · 2 스파크/일'\r\nend\r\n*p '</div>'\r\n*p '<div class=\"snk_diet_row\">'\r\nif room1_ration = 0:\r\n*p '<a class=\"snk_button \" tooltip-data=\"고열량식 선택됨\" href=\"EXEC: gt $curloc, ''diet''\"><img src=\"content/pic/buttons/sel_button.png\"></a>고열량식 · 4 스파크/일'\r\nelse\r\n*p '<a class=\"snk_button \" tooltip-data=\"고열량식\" href=\"EXEC: room1[''special_diet_days''] = 0 & room1_ration = 0 & $room1_info_text = $room1_ration[3] & gt $curloc, ''diet''\"><img src=\"content/pic/buttons/unsel_button.png\"></a>고열량식 · 4 스파크/일'\r\nend\r\n*p '</div>'\r\n*p '<div class=\"snk_diet_row\">'\r\nif room1_ration = 2:\r\n*p '<a class=\"snk_button \" tooltip-data=\"특별식단 선택됨\" href=\"EXEC: gt $curloc, ''diet''\"><img src=\"content/pic/buttons/sel_button.png\"></a>특별식단 · 8 스파크/일'\r\nelse\r\n*p '<a class=\"snk_button \" tooltip-data=\"특별식단\" href=\"EXEC: room1[''special_diet_days''] = 0 & room1_ration = 2 & $room1_info_text = $room1_ration[4] & gt $curloc, ''diet''\"><img src=\"content/pic/buttons/unsel_button.png\"></a>특별식단 · 8 스파크/일'\r\nend\r\n*p '</div>'\r\nelse\r\n*p '<p>개인실이 비어 있습니다.</p>'\r\nend\r\n*p '</div>'\r\nend",
