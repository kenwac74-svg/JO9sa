      "old": "$snk_room_view = $args[0]",
      "new": "$snk_room_view = $args[0]\r\n! JO9_PRIVATE_DIET_SELECTION_20261015\r\nif $snk_room_view = 'diet_set':\r\n if room1_state > CONST_INT['no_slave'] and args[1] >= 0 and args[1] <= 2:\r\n  if room1_ration ! args[1]: room1['special_diet_days'] = 0\r\n  room1_ration = args[1]\r\n end\r\n $snk_room_view = 'diet'\r\nend\r\nif $snk_room_view = 'diet':\r\n if room1_ration = 1: $room1_info_text = $room1_ration[2]\r\n if room1_ration = 0: $room1_info_text = $room1_ration[3]\r\n if room1_ration = 2: $room1_info_text = $room1_ration[4]\r\nend",
      "count": 1
