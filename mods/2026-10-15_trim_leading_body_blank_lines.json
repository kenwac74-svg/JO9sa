{
  "id": "2026-10-15_trim_leading_body_blank_lines",
  "description": "Remove only leading blank line tokens at narrative render boundaries, including old-save cached text. Preserve interior paragraphs, UI position and source prose.",
  "target": "game/jack.qsp",
  "before_sha256": "84d298ef0be15290283e0592fb0d8cd3c870c88752c17f0ecf013d62dc58f9f3",
  "after_sha256": "07e1c43299bec91f051b9eaee8db6fd145b12b06a9d3ff2a958234a7331fdf44",
  "add_locations": [
    {
      "name": "$jo9_trim_text_start",
      "desc": "",
      "body": "! JO9_LEADING_TEXT_NORMALIZER_20261015\r\n! Strip only empty prefix tokens; preserve all body and paragraph separators.\r\nlocal $jo9_trim_text = $args[0]\r\nlocal $jo9_trim_prefix = ''\r\nlocal jo9_trim_width = 0\r\nlocal $jo9_trim_head = ''\r\n:jo9_trim_text_prefix\r\njo9_trim_width = 0\r\nif len($jo9_trim_text) > 0:\r\n $jo9_trim_head = $mid($jo9_trim_text, 1, 1)\r\n if $jo9_trim_head = ' ' or $jo9_trim_head = $chr(9) or $jo9_trim_head = $chr(10) or $jo9_trim_head = $chr(13) or $jo9_trim_head = $chr(160):\r\n  jo9_trim_width = 1\r\n elseif $lcase($mid($jo9_trim_text, 1, 4)) = '<br>':\r\n  jo9_trim_width = 4\r\n elseif $lcase($mid($jo9_trim_text, 1, 5)) = '<br/>':\r\n  jo9_trim_width = 5\r\n elseif $lcase($mid($jo9_trim_text, 1, 6)) = '<br />' or $lcase($mid($jo9_trim_text, 1, 6)) = '&nbsp;':\r\n  jo9_trim_width = 6\r\n elseif instr($jo9_trim_text, '<span class=\"jo9-reference-body\">') = 1:\r\n  $jo9_trim_prefix = $jo9_trim_prefix + '<span class=\"jo9-reference-body\">'\r\n  jo9_trim_width = 33\r\n end\r\nend\r\nif jo9_trim_width > 0:\r\n $jo9_trim_text = $mid($jo9_trim_text, jo9_trim_width + 1, len($jo9_trim_text))\r\n jump 'jo9_trim_text_prefix'\r\nend\r\n$result = $jo9_trim_prefix + $jo9_trim_text\r\n",
      "actions": []
    }
  ],
