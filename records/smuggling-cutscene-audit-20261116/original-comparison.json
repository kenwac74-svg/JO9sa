      "branch": "if interaction_city = 6229:\n\tnpc = 1\n\t$npc_id = 'bararaika'\n\t$place = 'smugglers_den'\n\t$return_lock = 'shop_general'\n\tcreating_clone = 1\n\tgs 'generate_clone'\n\tgs 'stock_to_slave_nogt'\n\tcreating_clone = 0\n\tsparks -= 2000\n\tif snake_amulet_on = 0 and (brand_reputation > 2 or guild_reputation > 2):\n\t\tnpc = 1\n\t\t$npc_id = 'master_skups'\n\t\tbrand_rate -= 10\n\t\tguild_reputation_rate -= 10\n\t\tfine = max(500, sparks/3) &! minimum moneylender loan is 600, so as long as the slaver is not in debt, survival should be possible - ImperatorAugustus\n\t\tsparks -= fine\n\t\t$text[1] = '[마스터 스컵스]<br> 우리 조합이 당신같은 중요 인사를 감시 안하리라 여겼습니까? 어리석군! 저는 정평이 난 조합원이 이런 멍청한 편리나 취하리라곤 상상 못했습니다. 당장 이 <<fine>>$ 벌금을 지불하셔야 할 겁니다. 이 일로 떨어진 신의를 다시 쌓으려면 꽤 시간이 걸릴겁니다! <<$master_name>>!</div>'\n\t\t$return_lock = 'guild'\n\t\tdynamic $clear_slave_instance, 'stock'\n\t\thouse_mess_rate += 5\n\t\tmaster_hygiene_rate += 20\n\t\tmaster_excitement_rate = 0\n\t\tmaster_excitement = 0\n\t\tmaster_moodlet['neg_wealth'] = 3\n\t\tdynamic $master_energy_drop\n\t\tdynamic $master_energy_drop\n\t\tif assistant_state = CONST_INT['slave_exist']:\n\t\t\tassistant_rate['hygiene'] += 20\n\t\t\tdynamic $assistant_energy_drop\n\t\t\tdynamic $assistant_energy_drop\n\t\tend\n\telse\n\t\tbrand_rate -= 5\n\t\tguild_reputation_rate -= 5\n\t\t$text[1] = '[발랄라이카]<br> 운이 좋은 사내네, 막 들여놓은 참이었어. 스파크 먼저 건네고 여잘 데려가.</div>'\n\tend\nend",
      "logicSha256": "c9dc248e76ed679664ba0992a9cc184e260449b0f714b3f85ba98bdf0baa15d5",
      "dedicatedSpecialImageInBranch": false,
      "masterScoopsMapping": {
        "line": 412,
        "text": "$npc_image['master_skups'] = 'master_scoops'"
      },
      "npcImageRendering": {
        "line": 74,
        "lines": [
          "\t*p '<div id = \"side_panel_text\"><<$place_info[$place]>></div>'",
          "else",
          "\t$info_bar = ''",
          "\tif nsfw = 1:",
          "\t\t*p '<div id = \"bg\"><img src=\"content\\pic\\bg\\empty.png\"></div>'",
          "\telseif $npc_image[$npc_id] ! '':",
          "\t\t*p '<div id = \"bg\"><img src=\"content\\pic\\characters\\<<$npc_image[$npc_id]>>.png\"></div>'",
          "\tend",
          "\t*p '<div id = \"side_panel_main\"><center><div style=\"font-size: 40px;\"><<$npc_name[$npc_id]>></div><<$npc_status[$npc_id]>><br>'",
          "\t*nl '참고 정보:</center></div>'"
        ]
      },
      "cityEnd": [
        "",
        "end",
        "",
        "gt 'interaction_result_city'",
        ""
      ],
      "resultEnd": [
        "  gt 'item_buy'",
