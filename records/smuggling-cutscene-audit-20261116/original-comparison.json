      "clearHelper": {
        "line": 476,
        "text": "$clear_slave_instance = {\n\t_counter = arrsize('$slave_vars')\n\t:_clear_slave_instance_loop\n\t\t_counter -= 1\n\t\tkillvar $replace($slave_vars[_counter], 'instance', $args[0])\n\tif _counter > 0: jump '_clear_slave_instance_loop'\n\tkillvar '_counter'\n\n\tdynamic \"\n\t\t$<<$args[0]>>['wpn'] = 'безоружный' &! fists\n\t\t$<<$args[0]>>['right_wpn'] = 'безоружный' &! fists\n\t\t$<<$args[0]>>['left_wpn'] = 'безоружный' &! fists\n\t\t$<<$args[0]>>['armor'] = 'без_брони' &! without armor\n\t\t$<<$args[0]>>['cloth'] = 'голая' &! naked\n\t\"\n\t\n\t! update strings that may contain if statements or subexpressions referring to the cleared slave instance\n\n!\tif hero_choice > 100: gs '#var_base_woman'\n\t\n\tgs '#var_base'\n\tgs '#txt_man'   &! after #var_base\n\tgs '#txt_2_man' &! after #var_base\n!\tif hero_choice > 100: gs '#txt_woman' &! after #var_base\n!\tif hero_choice > 100: gs '#txt_2_woman' &! after #var_base\nend\nend\n}",
