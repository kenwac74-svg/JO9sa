        "  $text[1] = '가격은 <<item_price[$item_id]>> 스파크다 — 가격이 지금 네가 감당할 수 있는 것보다 조금 비싸지만, 그건 쉽게 해결된다. 노예 두어 명만 팔면 된다…'",
        " END",
        "END",
        "",
        "!completion tags",
        "city_already_done_today[$str(interaction_city)] += 1",
        "city_already_done_ever[$str(interaction_city)] += 1",
        "",
        "if txt_is_set_from_save = 0: txt = 1",
