  source:'jo9_duplicato:1 · jo9_duplicato_traits:1 · interaction_city:'+line(city,learn.index),usage:'menu_form:'+line(form,menuCall.index)+' → jo9_duplicato',linked:true,sourceQspSha256:hash,
  code:'! location: jo9_duplicato\n'+spell+'\n\n! location: jo9_duplicato_traits\n'+traits}];
