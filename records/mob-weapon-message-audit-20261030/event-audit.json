    },
    {
      "location": "#противники",
      "line": 3514,
      "text": "$атака_3_текст['egeya'] = \"에게야는 글라디우스를 치켜들고 당신을 향해 <font color='red'>힘껏</font> 내리쳤다.\""
    },
    {
      "location": "#противники",
      "line": 3520,
      "text": "$суператака_1_текст['egeya'] = \"에게야가 글라디우스로 <font color='red'>강력한</font> 일격을 가해 당신의 몸을 깊이 베었다.\""
