  "risks": [
    {
      "id": "NON_EQUIVALENT_STATE",
      "severity": "high",
      "fact": "Legacy signed numeric axis and one-time acquisition flag encode different states; no lossless one-key Boolean mapping."
    },
    {
      "id": "RETROACTIVE_INITIALIZATION",
      "severity": "high",
      "fact": "Setting new flag and initialized=0 on old actors may reset fear/angst/spoil/arousal, set rational/custom/moral, alter ego and accumulated rates, and raise obedience through normal recalculation."
    },
    {
      "id": "NO_PERMANENT_OBEDIENCE",
      "severity": "high",
      "fact": "Initialized flag prevents repeated initializer; subsequent play may change obedience and key stats while trait flag remains one. Reapplying every refresh would introduce permanent obedience not present today."
    },
    {
      "id": "LEGACY_GATE_CONFLICT",
      "severity": "high",
      "fixedJsonFiles": 34,
      "actorSnapshots": 118,
      "fact": "Unconditional conversion conflicts with high ego/pride and possible defiant combinations. Counts are JSON files / saved role snapshots, not unique people."
    },
    {
      "id": "SIGNED_AXIS_LOSS",
      "severity": "high",
      "fact": "Negative meekness represents free spirit; replacing it destroys an existing separate axis. Negative meekness + new trait is possible under current roll even though absent from sampled saves."
    },
    {
      "id": "VALUE_LOSS_OR_STACK",
      "severity": "high",
      "fact": "Converting meekness values 1/3/4/5/6 to Boolean 1 loses magnitude; blindly adding new bonus can stack existing persistent bonuses. Current two effects may coexist intentionally."
    },
    {
      "id": "DISCOVERY_AND_SLOTS",
      "severity": "medium",
      "fact": "Old trait discovery and new always-visible flag differ; display unification may reveal hidden legacy data. No fixed trait slot cap established; style argument 5 is only color."
    },
    {
      "id": "RESTORATION",
      "severity": "high",
      "fact": "Before any future migration keep raw meekness/revealed/flag/initialized and modified stats/rates or leave legacy storage intact. Changing a label only is reversible without save migration."
    }
  ],
