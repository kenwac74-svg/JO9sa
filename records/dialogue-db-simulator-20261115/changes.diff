+ORIGINAL={'relation','obed','urge','fear','ratio','instinct','custom','spoil','moral'}
+FIELDS={'text','role','types','relations','emotion','tone','level','question','good_mood','rare_praise','need_fear'}
+INDEX=r'''(?:'(?:''|[^'])*'|"(?:""|[^"])*")'''
