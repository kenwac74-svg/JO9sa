+  talk:{book:{background:{world:'industrial'},lines:{hello:'Saved'}}},
+  book:{background:{world:'modern'},lines:{hello:'Unsaved draft'},notes:'Manual draft'},
+  bgVersion:1, bgUnsaved:true, bookDirty:true, talkPending:0};
