+import test from 'node:test';import assert from 'node:assert/strict';
+import {roleUrl,nativeRows,patchNativeStat,cloneBody,masterSettings,cloneForm} from '../overrides/studio-role.mjs';
+test('master and slave URLs and same numeric IDs remain distinct',()=>{assert.equal(roleUrl('master','/api/char/101/images'),'/api/master/101/images');assert.equal(roleUrl('master','/api/talkbook/101'),'/api/master/101/talkbook');assert.equal(roleUrl('slave','/api/char/101'),'/api/char/101');assert.equal(roleUrl('master','/api/game'),'/api/game');});
+test('changing a stat preserves commands comments and quoted text',()=>{const code=" master_str = 4 &! keep\r\n$thing = 'master_str = 4'\r\nif x: sparks += 9";assert.equal(patchNativeStat(code,'master_str',3),code.replace('master_str = 4 &','master_str = 3 &'));assert.equal(nativeRows('master_str = 4\nmaster_str = 3')[0].repeated,true);assert.throws(()=>patchNativeStat('master_str = 4\nmaster_str = 3','master_str',2));});
+test('unchecked stats never carry conversion overrides',()=>{const d={include:{appearance:true,stats:false},targetRole:'master',overrides:{master_str:4}};assert.deepEqual(cloneBody(d,'rev').overrides,{});assert.deepEqual(cloneBody(d,'rev').include,['appearance']);});
+test('automatic target ID remains the ID reviewed in preview',()=>{assert.equal(cloneBody({include:{},newId:'',result:{id:125}},'rev').newId,125);});
+test('user text is escaped in master and clone forms',()=>{const x=masterSettings({name:'<script>x</script>',description:'</textarea>'},'master');assert(!x.includes('<script>'));assert(x.includes('&lt;/textarea&gt;'));assert(cloneForm({targetRole:'slave',name:'<img>',include:{},overrides:{},rows:[]}).includes('&lt;img&gt;'));});
