! Diagnostic Start fragment for jo9_rumor_match.
! Run only in an isolated candidate after refresh_database.
! This fragment deliberately replaces diagnostic actor and metadata fixtures.
! Parent appends the success marker after this fragment.
jo9_rumor_qa_failed = 0
jo9_rumor_qa_count = 0
jo9_rumor_qa_native_count = 0
$jo9_rumor_qa_reset = {
 killvar 'jo9_rumor_probe'
 killvar '$jo9_rumor_probe'
 killvar 'jo9_rumor_probe_rate'
 killvar '$jo9_rumor_probe_rate'
 killvar 'jo9_rumor_spec'
 jo9_rumor_probe_state = CONST_INT['slave_exist']
 jo9_rumor_probe_type = 99999
 $jo9_rumor_probe_name = 'QA'
 $jo9_rumor_probe_psy_status = 'obedient'
 jo9_rumor_probe['age'] = CONST_INT['young_age']
 jo9_rumor_probe['fat'] = 2
 jo9_rumor_probe['exotic'] = 2
 jo9_rumor_probe['beauty'] = 5
 jo9_rumor_probe['base_beauty'] = 5
 jo9_rumor_probe['stamina'] = 5
 jo9_rumor_probe['energy'] = 0
 jo9_rumor_probe['virginity'] = 1
 jo9_rumor_probe['style'] = 5
 jo9_rumor_probe['moral'] = 5
 jo9_rumor_probe['instinct'] = 5
 jo9_rumor_probe['custom'] = 5
 jo9_rumor_probe['rational'] = 5
 jo9_rumor_probe['mood'] = 5
 jo9_rumor_probe['meekness'] = 5
 jo9_rumor_probe['jo9_versatile'] = 1
 jo9_rumor_probe_rate['beauty'] = 200
 jo9_rumor_probe['sub_selfpain'] = 5
 jo9_rumor_qa_seed_i = 0
 loop while jo9_rumor_qa_seed_i < arrsize('$jo9_rumor_qa_stat_keys'):
  jo9_rumor_probe[$jo9_rumor_qa_stat_keys[jo9_rumor_qa_seed_i]] = 5
  jo9_rumor_qa_seed_i += 1
 end
 jo9_rumor_probe['pride'] = 0
 jo9_rumor_spec['servant'] = 5
 jo9_rumor_rating = 5
 jo9_rumor_charm = 100
 demand_rating['qa_fixed'] = 2
 $interesting_specialisation['qa_fixed'] = 'servant'
 $buyer_demand['qa_fixed'] = ''
 $npc_preferences['qa_fixed'] = ''
 day = 100
 no_loli = 0
 game_difficulty = 2
 is_stock = 0
 brand_reputation = 0
 wizard_mode = 0
 snk_room_target = 0
 killvar 'demand'
 killvar '$demand'
 killvar 'stat_importance'
 killvar '$stat_importance'
 demand['qa_keep'] = 731
 demand['qa_keep2'] = 732
 $demand['qa_keep'] = 'demand_string_sentinel'
 stat_importance['qa_keep'] = 741
 stat_importance['qa_keep2'] = 742
 $stat_importance['qa_keep'] = 'importance_string_sentinel'
 $npc_id = 'qa_original_npc'
 brand_rate = 751
 buyer_interested = 752
 sl_txt = 753
 jo9_meiki_max_sale = 754
 virgin_price = 755
 $virgin_price = 'virgin_string_sentinel'
 charm_demand = 756
 rating = 757
 charm = 758
 buyer_from_house = 759
 slaveprice = 760
 haggling_limit = 761
 relative_rating = 762
 slave_state = 763
 slave_type = 764
 $slave_name = 'slave_name_sentinel'
 $slave_psy_status = 'slave_psy_sentinel'
 slave['qa_actor_keep'] = 765
 $slave['qa_actor_keep'] = 'slave_array_sentinel'
 slave_rate['qa_rate_keep'] = 766
}
$jo9_rumor_qa_snapshot = {
 jo9_rumor_qa_before_demand_size = arrsize('demand')
 jo9_rumor_qa_before_demand_string_size = arrsize('$demand')
 jo9_rumor_qa_before_importance_size = arrsize('stat_importance')
 jo9_rumor_qa_before_importance_string_size = arrsize('$stat_importance')
 jo9_rumor_qa_before_state = jo9_rumor_probe_state
 jo9_rumor_qa_before_type = jo9_rumor_probe_type
 $jo9_rumor_qa_before_name = $jo9_rumor_probe_name
 $jo9_rumor_qa_before_psy = $jo9_rumor_probe_psy_status
 jo9_rumor_qa_before_grade_demand = demand_rating['qa_fixed']
 $jo9_rumor_qa_before_interesting_spec = $interesting_specialisation['qa_fixed']
 copyarr 'jo9_rumor_qa_before_probe', 'jo9_rumor_probe'
 copyarr '$jo9_rumor_qa_before_probe', '$jo9_rumor_probe'
 copyarr 'jo9_rumor_qa_before_rate', 'jo9_rumor_probe_rate'
 copyarr 'jo9_rumor_qa_before_spec', 'jo9_rumor_spec'
 $jo9_rumor_qa_before_demand = $buyer_demand['qa_fixed']
 $jo9_rumor_qa_before_preferences = $npc_preferences['qa_fixed']
 jo9_rumor_qa_before_rating = jo9_rumor_rating
 jo9_rumor_qa_before_charm = jo9_rumor_charm
}
$jo9_rumor_qa_guard = {
 if jo9_rumor_probe_state ! jo9_rumor_qa_before_state or jo9_rumor_probe_type ! jo9_rumor_qa_before_type or $jo9_rumor_probe_name ! $jo9_rumor_qa_before_name or $jo9_rumor_probe_psy_status ! $jo9_rumor_qa_before_psy: jo9_rumor_qa_failed = 1 & msg 'FAIL_RUMOR_PROBE_IDENTITY_<<$jo9_rumor_qa_label>>' & exit
 if demand_rating['qa_fixed'] ! jo9_rumor_qa_before_grade_demand or $interesting_specialisation['qa_fixed'] ! $jo9_rumor_qa_before_interesting_spec: jo9_rumor_qa_failed = 1 & msg 'FAIL_RUMOR_BUYER_METADATA_<<$jo9_rumor_qa_label>>' & exit
 if arrsize('demand') ! jo9_rumor_qa_before_demand_size or demand['qa_keep'] ! 731 or demand['qa_keep2'] ! 732: jo9_rumor_qa_failed = 1 & msg 'FAIL_RUMOR_DEMAND_STATE_<<$jo9_rumor_qa_label>>' & exit
 if arrsize('$demand') ! jo9_rumor_qa_before_demand_string_size or $demand['qa_keep'] ! 'demand_string_sentinel': jo9_rumor_qa_failed = 1 & msg 'FAIL_RUMOR_DEMAND_STRING_<<$jo9_rumor_qa_label>>' & exit
 if arrsize('stat_importance') ! jo9_rumor_qa_before_importance_size or stat_importance['qa_keep'] ! 741 or stat_importance['qa_keep2'] ! 742: jo9_rumor_qa_failed = 1 & msg 'FAIL_RUMOR_IMPORTANCE_STATE_<<$jo9_rumor_qa_label>>' & exit
 if arrsize('$stat_importance') ! jo9_rumor_qa_before_importance_string_size or $stat_importance['qa_keep'] ! 'importance_string_sentinel': jo9_rumor_qa_failed = 1 & msg 'FAIL_RUMOR_IMPORTANCE_STRING_<<$jo9_rumor_qa_label>>' & exit
 if $npc_id ! 'qa_original_npc' or brand_rate ! 751 or buyer_interested ! 752 or sl_txt ! 753: jo9_rumor_qa_failed = 1 & msg 'FAIL_RUMOR_CUSTOMER_GLOBAL_<<$jo9_rumor_qa_label>>' & exit
 if jo9_meiki_max_sale ! 754 or virgin_price ! 755 or $virgin_price ! 'virgin_string_sentinel' or charm_demand ! 756: jo9_rumor_qa_failed = 1 & msg 'FAIL_RUMOR_PRICE_GLOBAL_<<$jo9_rumor_qa_label>>' & exit
 if rating ! 757 or charm ! 758 or buyer_from_house ! 759 or slaveprice ! 760 or haggling_limit ! 761 or relative_rating ! 762: jo9_rumor_qa_failed = 1 & msg 'FAIL_RUMOR_APPRAISAL_GLOBAL_<<$jo9_rumor_qa_label>>' & exit
 if slave_state ! 763 or slave_type ! 764 or $slave_name ! 'slave_name_sentinel' or $slave_psy_status ! 'slave_psy_sentinel': jo9_rumor_qa_failed = 1 & msg 'FAIL_RUMOR_SELECTED_ACTOR_<<$jo9_rumor_qa_label>>' & exit
 if slave['qa_actor_keep'] ! 765 or $slave['qa_actor_keep'] ! 'slave_array_sentinel' or slave_rate['qa_rate_keep'] ! 766: jo9_rumor_qa_failed = 1 & msg 'FAIL_RUMOR_SELECTED_ARRAY_<<$jo9_rumor_qa_label>>' & exit
 if day ! 100 or no_loli ! 0 or game_difficulty ! 2 or is_stock ! 0 or brand_reputation ! 0: jo9_rumor_qa_failed = 1 & msg 'FAIL_RUMOR_WORLD_GLOBAL_<<$jo9_rumor_qa_label>>' & exit
 if arrsize('jo9_rumor_match_demand') ! 0 or arrsize('$jo9_rumor_match_demand') ! 0 or arrsize('jo9_rumor_match_importance') ! 0 or arrsize('$jo9_rumor_match_importance') ! 0: jo9_rumor_qa_failed = 1 & msg 'FAIL_RUMOR_TEMP_CLEANUP_<<$jo9_rumor_qa_label>>' & exit
 if arrsize('jo9_rumor_probe') ! arrsize('jo9_rumor_qa_before_probe') or arrsize('$jo9_rumor_probe') ! arrsize('$jo9_rumor_qa_before_probe'): jo9_rumor_qa_failed = 1 & msg 'FAIL_RUMOR_PROBE_SIZE_<<$jo9_rumor_qa_label>>' & exit
 jo9_rumor_qa_guard_i = 0
 loop while jo9_rumor_qa_guard_i < arrsize('jo9_rumor_probe'):
  if jo9_rumor_probe[jo9_rumor_qa_guard_i] ! jo9_rumor_qa_before_probe[jo9_rumor_qa_guard_i]: jo9_rumor_qa_failed = 1 & msg 'FAIL_RUMOR_PROBE_VALUE_<<$jo9_rumor_qa_label>>' & exit
  jo9_rumor_qa_guard_i += 1
 end
 jo9_rumor_qa_guard_i = 0
 loop while jo9_rumor_qa_guard_i < arrsize('$jo9_rumor_probe'):
  if $jo9_rumor_probe[jo9_rumor_qa_guard_i] ! $jo9_rumor_qa_before_probe[jo9_rumor_qa_guard_i]: jo9_rumor_qa_failed = 1 & msg 'FAIL_RUMOR_PROBE_STRING_<<$jo9_rumor_qa_label>>' & exit
  jo9_rumor_qa_guard_i += 1
 end
 if arrsize('jo9_rumor_probe_rate') ! arrsize('jo9_rumor_qa_before_rate') or arrsize('jo9_rumor_spec') ! arrsize('jo9_rumor_qa_before_spec'): jo9_rumor_qa_failed = 1 & msg 'FAIL_RUMOR_RATE_SPEC_SIZE_<<$jo9_rumor_qa_label>>' & exit
 jo9_rumor_qa_guard_i = 0
 loop while jo9_rumor_qa_guard_i < arrsize('jo9_rumor_probe_rate'):
  if jo9_rumor_probe_rate[jo9_rumor_qa_guard_i] ! jo9_rumor_qa_before_rate[jo9_rumor_qa_guard_i]: jo9_rumor_qa_failed = 1 & msg 'FAIL_RUMOR_RATE_VALUE_<<$jo9_rumor_qa_label>>' & exit
  jo9_rumor_qa_guard_i += 1
 end
 jo9_rumor_qa_guard_i = 0
 loop while jo9_rumor_qa_guard_i < arrsize('jo9_rumor_spec'):
  if jo9_rumor_spec[jo9_rumor_qa_guard_i] ! jo9_rumor_qa_before_spec[jo9_rumor_qa_guard_i]: jo9_rumor_qa_failed = 1 & msg 'FAIL_RUMOR_SPEC_VALUE_<<$jo9_rumor_qa_label>>' & exit
  jo9_rumor_qa_guard_i += 1
 end
 if $buyer_demand['qa_fixed'] ! $jo9_rumor_qa_before_demand or $npc_preferences['qa_fixed'] ! $jo9_rumor_qa_before_preferences: jo9_rumor_qa_failed = 1 & msg 'FAIL_RUMOR_METADATA_<<$jo9_rumor_qa_label>>' & exit
 if jo9_rumor_rating ! jo9_rumor_qa_before_rating or jo9_rumor_charm ! jo9_rumor_qa_before_charm: jo9_rumor_qa_failed = 1 & msg 'FAIL_RUMOR_INPUT_GLOBAL_<<$jo9_rumor_qa_label>>' & exit
}
$jo9_rumor_qa_run = {
 dynamic $jo9_rumor_qa_snapshot
 jo9_rumor_qa_got = func('jo9_rumor_match', 'qa_fixed', $jo9_rumor_qa_mode, jo9_rumor_qa_no_charm)
 if jo9_rumor_qa_got ! jo9_rumor_qa_expect: jo9_rumor_qa_failed = 1 & msg 'FAIL_RUMOR_MATCH_<<$jo9_rumor_qa_label>>' & exit
 dynamic $jo9_rumor_qa_guard
 if jo9_rumor_qa_failed = 1: exit
 jo9_rumor_qa_count += 1
}
! Native comparison appraises its isolated actor first and then copies the
! actual resulting rating, charm and specialisation into matcher inputs.
! This separate phase permits known native checker mutations.
$jo9_rumor_qa_native = {
 killvar 'slave'
 killvar '$slave'
 killvar 'slave_rate'
 killvar '$slave_rate'
 copyarr 'slave', 'jo9_rumor_probe'
 copyarr '$slave', '$jo9_rumor_probe'
 copyarr 'slave_rate', 'jo9_rumor_probe_rate'
 slave_state = jo9_rumor_probe_state
 slave_type = jo9_rumor_probe_type
 $slave_name = $jo9_rumor_probe_name
 $slave_psy_status = $jo9_rumor_probe_psy_status
 gs '$slave_price'
 copyarr 'jo9_rumor_probe', 'slave'
 copyarr '$jo9_rumor_probe', '$slave'
 copyarr 'jo9_rumor_probe_rate', 'slave_rate'
 copyarr 'jo9_rumor_spec', 'slave_specialisation'
 jo9_rumor_rating = rating
 jo9_rumor_charm = charm
 jo9_rumor_qa_native_match = func('jo9_rumor_match', 'qa_fixed', 'full', 0)
 $npc_id = 'qa_fixed'
 buyer_from_house = 0
 sl_txt = 1
 gs 'slave_sell_chek'
 if buyer_interested ! jo9_rumor_qa_native_match: jo9_rumor_qa_failed = 1 & msg 'FAIL_RUMOR_NATIVE_PARITY_<<$jo9_rumor_qa_label>>' & exit
 if jo9_rumor_qa_native_match ! jo9_rumor_qa_expect: jo9_rumor_qa_failed = 1 & msg 'FAIL_RUMOR_NATIVE_EXPECT_<<$jo9_rumor_qa_label>>' & exit
 jo9_rumor_qa_native_count += 1
}
