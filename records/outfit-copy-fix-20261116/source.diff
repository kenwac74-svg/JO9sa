-        target = _abs_from_gamepath(root, reference)
-        if users:
-            log("   [공유 보존] %s · ID %s" % (os.path.basename(target), ", ".join(str(n) for n in sorted(users))))
-        else:
-            _rm(target, log)
-
-    # 프리셋(풀 밖) 또는 밴드 판별 불가 -> json 만 지우면 끝
