+def clean_unique_slug(text):
+    """JSON 파일명에 붙일 영문 이름. 영문·숫자·밑줄·하이픈만 남긴다."""
+    return re.sub(r"[^A-Za-z0-9_-]+", "", (text or "").strip().replace(" ", "_"))
