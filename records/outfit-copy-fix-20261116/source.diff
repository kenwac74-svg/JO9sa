+    """
+    info = AGE_INFO[age]
+    idx = read_index(paths)
+    last = int(idx.get(info["index_key"], info["band_first"] - 1))
+    nid = last + 1
+    while _character_json_matches(paths, nid):
+        nid += 1
+    return nid
