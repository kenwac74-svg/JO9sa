+    nid = UNIQUE_ID_FIRST
+    while _character_json_matches(paths, nid):
+        nid += 1
+        if nid > UNIQUE_ID_LAST:
+            raise ValueError("고유 캐릭터 자동 번호가 가득 찼습니다. 번호를 직접 지정하세요.")
+    return nid
