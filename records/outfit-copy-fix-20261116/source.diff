-        new_ids = [n for n in ids if n not in (sid, last)] + [sid]
-        idx[key] = max(new_ids) if new_ids else first - 1
-        _save_index(paths, idx)
-        log("   [OK] %s -> %d" % (key, idx[key]))
-
-    elif is_end:
-        # 맨끝 삭제: 완전 제거 + _last 를 남은 최대값으로
