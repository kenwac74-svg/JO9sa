+def story_to_display(value):
+    """JSON 문장 -> 편집창 문장. 끝의 #nwtx 표시를 떼고 <br> 을 줄바꿈으로 바꾼다."""
+    text = (value or "")
+    text = re.sub(r"<!--\s*#nwtx.*?-->\s*$", "", text, flags=re.S)
+    return re.sub(r"<br\s*/?>", "\n", text).strip()
