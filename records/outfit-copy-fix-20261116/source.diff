+class StudioHandler(http.server.SimpleHTTPRequestHandler):
+    def __init__(self, *args, **kwargs):
+        super().__init__(*args, directory=str(DIST), **kwargs)
+
+    def end_headers(self):
+        # 편집기를 고친 뒤에도 브라우저가 예전 파일을 쓰지 않게 한다
+        self.send_header('Cache-Control', 'no-store, max-age=0')
+        super().end_headers()
+
+    def log_message(self, *args):
+        pass
+
+    def send_json(self, status, payload):
+        body = json.dumps(payload, ensure_ascii=False).encode('utf-8')
+        self.send_response(status)
+        self.send_header('Content-Type', 'application/json; charset=utf-8')
+        self.send_header('Content-Length', str(len(body)))
+        self.end_headers()
+        self.wfile.write(body)
+
+    def fail(self, error):
+        status = {ai_api.AiError: 400, LookupError: 409, FileNotFoundError: 404, PermissionError: 403, ValueError: 400, FileExistsError: 409}
+        code = next((v for k, v in status.items() if isinstance(error, k)), 500)
+        self.send_json(code, {'error': str(error) or error.__class__.__name__})
+
+    def do_GET(self):
+        url = urlparse(self.path)
+        # 화면 파일은 버전별 주소(/v/<빌드>/…)로 낸다. 브라우저가 예전 편집기 파일을 캐시에 들고 있어도 주소가 달라 섞이지 않는다
+        if url.path in ('/', '/index.html'):
+            self.send_response(302)
+            self.send_header('Location', f'/v/{BUILD_ID}/' + (f'?{url.query}' if url.query else ''))
+            self.send_header('Content-Length', '0')
+            self.end_headers()
+            return
+        if url.path.startswith('/v/'):
+            parts = url.path.split('/', 3)
+            self.path = '/' + (parts[3] if len(parts) > 3 else '') + (f'?{url.query}' if url.query else '')
+            url = urlparse(self.path)
+        if url.path.startswith('/game/'):
+            try:
+                body, mime = game_file(url.path[len('/game/'):])
+            except Exception as error:  # noqa: BLE001 - 화면에 이유를 돌려준다
+                return self.fail(error)
+            self.send_response(200)
+            self.send_header('Content-Type', mime)
+            self.send_header('Content-Length', str(len(body)))
+            self.end_headers()
+            return self.wfile.write(body)
+        for pattern, handler in ROUTES_GET:
+            m = pattern.match(url.path)
+            if m:
+                try:
+                    return self.send_json(200, handler(m, url.query))
+                except Exception as error:  # noqa: BLE001
+                    return self.fail(error)
+        if url.path.startswith('/api/'):
+            return self.send_json(404, {'error': '없는 주소입니다.'})
+        if url.path == '/build.txt':
+            body = BUILD_ID.encode('utf-8')
+            self.send_response(200)
+            self.send_header('Content-Type', 'text/plain; charset=utf-8')
+            self.send_header('Content-Length', str(len(body)))
+            self.end_headers()
+            return self.wfile.write(body)
+        # 원문을 채운 참조표(fetch_originals.py가 만든 local/)가 있으면 그것을 낸다
+        local_refs = HERE / 'docs' / 'sextalk-interviews' / 'local' / 'interview-refs.json'
+        if url.path == '/data/interview-refs.json' and local_refs.is_file():
+            body = local_refs.read_bytes()
+            self.send_response(200)
+            self.send_header('Content-Type', 'application/json; charset=utf-8')
+            self.send_header('Content-Length', str(len(body)))
+            self.end_headers()
+            return self.wfile.write(body)
+        return super().do_GET()
+
+    def do_POST(self):
+        url = urlparse(self.path)
+        # 다른 사이트가 이 PC의 편집기에 쓰기 요청을 보내지 못하게 같은 출처만 받는다
+        origin = self.headers.get('Origin')
+        if origin and urlparse(origin).hostname not in ('127.0.0.1', 'localhost'):
+            return self.send_json(403, {'error': '허용되지 않은 출처입니다.'})
+        if self.headers.get('Content-Type', '').split(';')[0].strip() != 'application/json':
+            return self.send_json(415, {'error': 'JSON 요청만 받습니다.'})
+        length = int(self.headers.get('Content-Length') or 0)
+        if length > MAX_BODY:
+            return self.send_json(413, {'error': '요청이 너무 큽니다.'})
+        try:
+            body = json.loads(self.rfile.read(length).decode('utf-8') or '{}')
+        except ValueError:
+            return self.send_json(400, {'error': 'JSON을 읽지 못했습니다.'})
+        for pattern, handler in ROUTES_POST:
+            m = pattern.match(url.path)
+            if m:
+                try:
+                    with _lock:
+                        return self.send_json(200, handler(m, body))
+                except Exception as error:  # noqa: BLE001
+                    return self.fail(error)
+        return self.send_json(404, {'error': '없는 주소입니다.'})
