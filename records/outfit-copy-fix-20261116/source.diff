+
+
+def registry_next_id(paths, age):
+    """
+    새 슬레이브 ID = slave_index 의 <나이>_last + 1.
+    json/slaves 레지스트리는 밴드 시작번호부터 _last 까지 빈틈없이 이어져 있어야 하며,
