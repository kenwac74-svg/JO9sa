+def band_and_key(sid):
+    """ID -> (밴드명, slave_index 키, 밴드 시작번호). 풀 밴드가 아니면 (None,None,None)."""
+    for age, info in AGE_INFO.items():
+        first = info["band_first"]
+        if first <= sid <= first + 999:
+            return age, info["index_key"], first
+    return None, None, None
