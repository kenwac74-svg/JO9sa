+# ---------------------------------------------------------------------------
+# 외형(하녀/도미나/비서) 이미지 저장 + 기존 캐릭터 수정
+# ---------------------------------------------------------------------------
+
+OUTFIT_FIELD_TO_SUB = {field: sub for field, _lbl, sub in OUTFITS}
+OUTFIT_LABELS = {field: lbl for field, lbl, _sub in OUTFITS}
