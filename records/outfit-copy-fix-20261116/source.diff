+def _save_slave_json(fn, data):
+    """json 을 .bak 백업 후 저장."""
+    backup = fn + ".bak"
+    if not os.path.exists(backup):
+        shutil.copy2(fn, backup)
+    with open(fn, "w", encoding="utf-8") as f:
+        json.dump(data, f, indent=4, ensure_ascii=False)
