+
+def metadata(raw):
+ q=QspDocument(raw);static=q.body('#static_base') if '#static_base' in q.index else '';var=q.body('#variative') if '#variative' in q.index else '';debug=q.body('debug_info') if 'debug_info' in q.index else ''
