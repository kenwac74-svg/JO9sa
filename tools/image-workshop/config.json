{
  "version": 1,
  "server": {
    "idleTimeoutSeconds": 90,
    "startupGraceSeconds": 30,
    "startupWaitMilliseconds": 5000
  },
  "detect": {
    "retryCount": 2,
    "retryDelayMilliseconds": 220,
    "showFailurePopup": true,
    "showHtmlKeySequence": [
      "ALT",
      "RIGHT",
      "RIGHT",
      "DOWN",
      "DOWN",
      "ENTER"
    ]
  },
  "logs": {
    "maxKilobytes": 512
  }
}